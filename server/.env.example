# --- Application ---
# 'development' or 'production'. Production refuses to start with a default
# SECRET_KEY or a wildcard CORS origin.
APP_ENV=development
SECRET_KEY=change-me-run-python3-c-import-secrets-print-secrets-token_hex-32

# --- MongoDB ---
MONGO_URI=<your-mongo-connection-string>
DATABASE_NAME=Speaksure2

# --- External APIs ---
ASSEMBLYAI_API_KEY=<your-assemblyai-api-key>
GEMINI_API_KEY=<your-gemini-api-key>

# --- CORS ---
# Comma-separated origins. Leave EMPTY in production when nginx serves the
# frontend and the API from the same domain.
CORS_ORIGINS=http://localhost:6173,http://127.0.0.1:6173

# --- Limits / tuning ---
MAX_UPLOAD_BYTES=104857600
TORCH_NUM_THREADS=2
THREAD_POOL_SIZE=8

# --- Model cache (set on the server so it is not in the service user's home) ---
# HF_HOME=/opt/speaksure/hf-cache
